APP_NAME=APEX Football Council Analyzer
APP_ENV=local
CACHE_TTL_SECONDS=900
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_KEY=
ODDS_REGIONS=eu,uk
ODDS_MARKETS=h2h,totals
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
LLM_COUNCIL_MODE=rules
DATA_CONFIDENCE_MIN=0.60
EDGE_MIN=0.035

# Modèle statistique (Dixon-Coles + ratings relatifs)
DC_RHO=-0.13
MAX_GOALS=10
HOME_ADV=1.10
AWAY_ADJ=0.92
LEAGUE_AVG_GOALS=1.35

# Lecture des cotes : "shin" ou "proportional" (retrait de marge avant edge)
DEVIG_METHOD=shin

# Gestion du risque
FLAT_STAKE_PCT=0.01

# Preuve d'edge : laisser False tant que la calibration n'est pas validée
CALIBRATION_PROVEN=False
MIN_SETTLED_BETS=100
TRACKING_DB_PATH=/tmp/apex_tracking.sqlite3

HOST=0.0.0.0
PORT=8000
